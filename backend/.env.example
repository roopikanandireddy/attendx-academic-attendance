# Backend Environment Variables
# Supabase Supavisor Pooler URL (recommended for IPv4 cloud providers like Render)
DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-SUPABASE-ANON-KEY]
JWT_SECRET=[YOUR-32-CHAR-SECRET-KEY]
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
FRONTEND_URL=https://attendx-web-721g.onrender.com

# Account Activation & Security Tokens
ACCOUNT_ACTIVATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=2

# Institutional Email Service Configuration
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USERNAME=apikey
EMAIL_PASSWORD=[YOUR-SMTP-API-KEY]
EMAIL_FROM=notifications@attendx.edu
EMAIL_FROM_NAME="AttendX Academic System"
EMAIL_USE_TLS=true

# Institutional Administrator Provisioning (Backend-only, supply at deployment)
ADMIN_ROOPIKA_PASSWORD=
ADMIN_SRIKANTH_PASSWORD=
